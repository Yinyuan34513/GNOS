# ---- nano smoke test -----------------------------------------------------
# The editor must really run: version banner first, then a real edit session
# on the boot console -- a background helper types ^X (Ctrl+X, 0x18) into the
# terminal a second after nano opens, and nano must exit cleanly with the
# file intact.  TERM=xterm needs the xterm terminfo entry, which the initrd
# carries under /usr/share/terminfo.
# echo NANOTEST: nano --version
# TERM=xterm /usr/bin/nano --version
# echo NANOTEST: version rc=$?
# printf 'hello from nano\n' > /tmp/nanotest.txt
# echo NANOTEST: opening /tmp/nanotest.txt with TERM=xterm
# ( sleep 1; printf '\030' ) &
