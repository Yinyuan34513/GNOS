# /etc/rc -- GNOS system startup script.
#
# Run once by init(8) through the shell, before the interactive prompt.
# The toy shell has no comment syntax, so every line is a real command;
# blank lines are ignored.  This is the GNOS analogue of a BSD rc or a
# single OpenRC runlevel, kept deliberately tiny until the rest of the
# userland (a real /bin/sh, /proc, libc) is in place.
# The kernel hands PID 1 an empty environment, so give every command a PATH
# up front -- OpenRC's scripts call `mount`, `checkpath` and friends by bare
# name and would otherwise fail with "command not found".
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
echo GNOS rc: starting up
mkdir /tmp/run
echo GNOS rc: ready
/bin/hello.elf
echo GNOS rc: hello exited with status $?
# BusyBox smoke test.  Both dispatch paths are exercised on purpose:
# /bin/busybox.elf reaches the multi-call dispatcher by name prefix, while
# /usr/bin/sed picks its applet out of argv[0].  sed is used for that second
# check rather than something obvious like echo because GNU coreutils now owns
# /usr/bin for every name it provides -- sed is one of the applets BusyBox
# still has to itself, so it is genuinely testing argv[0] dispatch.
#
# The rest of the block walks the write side of the filesystem -- mkdir, cp,
# mv, rm -- because that is where the ext2 driver is thinnest.  Those are the
# coreutils binaries now; /etc/coreutilstest.sh asserts on them properly, this
# is just the early, shell-visible pass.
echo GNOS rc: busybox
/bin/busybox.elf echo multicall dispatch ok
/usr/bin/sed -n 1p /etc/hostname
/usr/bin/uname -a
/usr/bin/pwd
/usr/bin/head -2 /etc/rc
/usr/bin/wc /etc/rc
/usr/bin/mkdir /tmp/bb
/usr/bin/cp /etc/rc /tmp/bb/copy
/usr/bin/wc -c /tmp/bb/copy
/usr/bin/mv /tmp/bb/copy /tmp/bb/moved
/usr/bin/ls -l /tmp/bb
/usr/bin/rm /tmp/bb/moved
/usr/bin/ls /tmp/bb
echo GNOS rc: busybox done

# Phase 1 probe: the login shell is /bin/bash and it must start interactive.
# bash -i forces interactive mode; an interactive bash sources ~/.bashrc, which
# prints the banner below -- so seeing the banner proves both that bash's
# interactive machinery initialises (job control, readline, signals) and that the
# new /root/.bashrc is in the image.  The tty ioctl fix is what makes
# isatty()/tcgetattr() succeed, without which bash refused interactive mode.
/bin/bash -i -c 'echo GNOS rc: bash interactive mode ok'
echo GNOS rc: bash-probe exited with status $?

# termios: assert the terminal answers the ioctls a real libc issues, that
# the defaults match Linux's, and that a background process gets SIGTTOU for
# reconfiguring it.  All of it is non-interactive, so it runs on every boot.
/bin/ttytest.elf
echo GNOS rc: ttytest exited with status $?
# readlinetest: drive the terminal through ttyinject(404) and confirm the
# line discipline delivers a canonical line, honours Backspace and Ctrl-D, and
# passes escape sequences through untouched in raw mode.  No human required.
/bin/readlinetest.elf
echo GNOS rc: readlinetest exited with status $?
# signals: assert user-installed handlers really run -- that the rt_sigframe
# byte-for-byte matches Linux (so musl's __restore_rt trampoline works), that
# sa_mask / SA_NODEFER / SA_RESETHAND behave, that a blocked signal stays
# pending, that the register and FPU context survives, and that SA_RESTART
# lets a cut-off read() finish.  All of it is non-interactive.
/bin/sigtest.elf
echo GNOS rc: sigtest exited with status $?
# fstest: assert the ext2/VFS symlink + rename support OpenRC relies on --
# symlink(2)/readlink(2)/lstat-vs-stat, rename(2), and dangling links.  No
# human required; everything is a printed assertion.
/bin/fstest.elf
echo GNOS rc: fstest exited with status $?

# mounttest: assert the kernel's mount(2)/getrandom(2) work -- tmpfs mounts
# on a directory and behaves like a real filesystem (write/read/mkdir/unlink/
# readdir all route into it), and getrandom returns varying non-zero bytes.
/bin/mounttest.elf
echo GNOS rc: mounttest exited with status $?

# ---- /etc/fstab ----------------------------------------------------------
# Replay the fstab before OpenRC runs, not after: the very first thing the
# sysinit runlevel does is checkpath its way around /run, and on a read-only
# root that fails outright.  `mount -a` brings up /run, /tmp and /dev/shm and
# skips the proc/sysfs lines this kernel answers ENODEV for.
echo GNOS rc: mount -a
/bin/mount -a
echo GNOS rc: mount -a exited with status $?
echo "--- mounted filesystems ---"
/bin/mount

# ---- coldplug ------------------------------------------------------------
# The udev-trigger equivalent: walk the kernel's subsystem registry through
# /proc/subsystems and prove that every driver that claims to be live really
# published the /dev node it advertises, and that the node behaves.  A driver
# that registers itself but forgets vfs_register_dev() fails here by name.
/bin/coldplug.elf
echo GNOS rc: coldplug exited with status $?
echo "--- /proc/devices ---"
/usr/bin/cat /proc/devices

# fbtest: the framebuffer seen the way a real Linux client sees it -- the
# <linux/fb.h> struct sizes, FBIOGET_[VF]SCREENINFO geometry, and an mmap of
# the whole scanout that must agree with read()/write() at both ends.
/bin/fbtest.elf
echo GNOS rc: fbtest exited with status $?

# ---- OpenRC --------------------------------------------------------------
# Bring the boot runlevels up through OpenRC's own machinery.  The initrd
# carries the full tree (/sbin/openrc, /etc/init.d/*, /etc/runlevels/*); this
# is exactly what the kernel's mount/getrandom/symlink/rename support was
# built to serve.  Scripts that need a filesystem our mount(2) cannot provide
# (proc/sys/devtmpfs) fail their mount and are skipped by design, so a missing
# feature degrades to a warning instead of stopping the boot.
#
# We are not using openrc-init as PID 1 (our own init.elf is), so a bare
# `openrc` only caches the dependency tree.  Naming the runlevels explicitly
# is what actually starts the services, the way openrc-init would sequence
# them: sysinit -> boot -> default.
echo GNOS rc: openrc sysinit
/sbin/openrc sysinit
echo GNOS rc: openrc sysinit exited with status $?
echo GNOS rc: openrc boot
/sbin/openrc boot
echo GNOS rc: openrc boot exited with status $?
echo GNOS rc: openrc default
/sbin/openrc default
echo GNOS rc: openrc default exited with status $?

# ---- GNU Bash -----------------------------------------------------------
# The shell this whole userland effort is aimed at.  /etc/bashtest.sh is a
# non-interactive assertion script: it exercises the parts of bash that lean
# hardest on the kernel -- fork/exec, pipelines, redirection, command
# substitution, wait statuses, traps -- and exits non-zero if any of them
# misbehaves, so a regression fails `make test` instead of waiting for
# somebody to notice it at a prompt.
echo GNOS rc: bash
/bin/bash /etc/bashtest.sh
echo GNOS rc: bashtest exited with status $?

# ---- GNU coreutils ------------------------------------------------------
# 104 statically linked GNU programs live in /usr/bin.  They lean on far more
# of the kernel than BusyBox ever did -- and gnulib wraps nearly every syscall
# in a probe-and-fall-back, so a missing feature does not crash, it quietly
# returns the wrong answer.  /etc/coreutilstest.sh is the assertion script
# that catches that; it runs under bash and exits with the failure count.
echo GNOS rc: coreutils
/bin/bash /etc/coreutilstest.sh
echo GNOS rc: coreutilstest exited with status $?

# ---- network bring-up (BusyBox tools) -----------------------------------
# Every ping here is bounded by -c: BusyBox's fancy ping otherwise runs until
# interrupted, and there is nobody at the keyboard during `make test`.  -W
# bounds the wait for a reply too, so an unreachable address costs seconds
# rather than hanging the boot.
echo GNOS rc: networking
/usr/bin/hostname -F /etc/hostname
echo "--- hostname ---"
/usr/bin/hostname
echo "--- /proc/net/dev ---"
/usr/bin/cat /proc/net/dev
echo "--- /proc/net/route ---"
/usr/bin/cat /proc/net/route
echo "--- ls /proc /proc/net ---"
/usr/bin/ls /proc /proc/net
/usr/bin/ifconfig -a
echo "--- ping loopback ---"
/usr/bin/ping -c2 -W2 127.0.0.1
echo "--- ping gateway (QEMU user-net 10.0.2.2) ---"
/usr/bin/ping -c2 -W2 10.0.2.2
echo GNOS rc: networking done

