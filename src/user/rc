# /etc/rc -- GNOS system startup script.
#
# Run once by init(8) through the shell, before the interactive prompt.
# The toy shell has no comment syntax, so every line is a real command;
# blank lines are ignored.  This is the GNOS analogue of a BSD rc or a
# single OpenRC runlevel, kept deliberately tiny until the rest of the
# userland (a real /bin/sh, /proc, libc) is in place.
# The kernel hands PID 1 an empty environment, so give every command a PATH
# up front -- OpenRC's scripts call `mount`, `checkpath` and friends by bare
# name and would otherwise fail with "command not found".
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
echo GNOS rc: starting up
mkdir /tmp/run
echo GNOS rc: ready
/bin/hello.elf
echo GNOS rc: hello exited with status $?

# ---- pthread self-test ---------------------------------------------------
# The kernel's thread support (CLONE_VM, tgid, blocking futex) has exactly
# one judge: musl's pthreads running on top of it.  Assert every part, the
# way the rest of the boot-time tests assert their subsystems.
echo GNOS rc: thrtest
/bin/thrtest.elf
echo GNOS rc: thrtest exited with status $?

# ---- CJK rendering smoke test -------------------------------------------
# The console decodes UTF-8 and paints 16x16 Unifont glyphs; this line is
# the boot-time witness.  A headless run decodes the framebuffer screenshot
# with tools/fbocr.py and asserts these four characters came out.
echo CJKTEST: 你好世界

# ---- DRM/KMS self-test ---------------------------------------------------
# /dev/dri/card0 must speak the Linux UAPI: caps, resources, dumb buffers
# and a real mode switch through the bochs VBE registers, then back.  The
# screen visibly flashes colour bars while it runs; the verdicts land on
# the debug console.
echo GNOS rc: drmtest
/bin/drmtest.elf
echo GNOS rc: drmtest exited with status $?

# ---- ptrace self-test ---------------------------------------------------
# The kernel's ptrace(2) must speak the Linux ABI: TRACEME, stop/wait
# reporting, peek/poke through the tracee's page tables, GETREGS and a
# TRACESYSGOOD syscall-entry stop, then a tracer-injected exit status.
echo GNOS rc: ptracetest
/bin/ptracetest.elf
echo GNOS rc: ptracetest exited with status $?

# ---- kernel module self-test ---------------------------------------------
# Loads moddemo.ko through finit_module(2), verifies /proc/modules and the
# driver registry see it, loads modpair.ko on top (which imports a symbol
# from moddemo.ko), exercises EBUSY-on-import, unload order, ENOENT, a
# garbage ENOEXEC, and the plain init_module(2) path.
echo GNOS rc: evtest
/bin/evtest.elf
echo GNOS rc: evtest exited with status $?
echo GNOS rc: eventest
/bin/eventest.elf
echo GNOS rc: eventest exited with status $?

echo GNOS rc: modtest
/bin/modtest.elf
echo GNOS rc: modtest exited with status $?

# ---- insmod/rmmod smoke test ---------------------------------------------
# The same syscalls modtest drives directly, exercised through the tools
# a user would actually type.  modtest above has unloaded everything, so
# this load/unload cycle is a clean one.
echo GNOS rc: insmod/rmmod smoke
/sbin/insmod /lib/modules/moddemo.ko && /sbin/rmmod moddemo
echo GNOS rc: insmod/rmmod exited with status $?

# ---- fastfetch smoke test ------------------------------------------------
# The system-info tool, run against the real OS (not the build machine):
# every module that cannot work here must degrade to nothing rather than
# crash.  The output is teed to the debug log through dbgcat so `make test`
# can see it; a framebuffer run shows the logo.
echo GNOS rc: fastfetch
/usr/bin/fastfetch --logo none > /var/log/fastfetch.log 2>&1
echo GNOS rc: fastfetch exited with status $?
/bin/dbgcat.elf /var/log/fastfetch.log

# ---- /etc/fstab ----------------------------------------------------------
# Replay the fstab before OpenRC runs, not after: the very first thing the
# sysinit runlevel does is checkpath its way around /run, and on a read-only
# root that fails outright.  `mount -a` brings up /run, /tmp and /dev/shm and
# skips the proc/sysfs lines this kernel answers ENODEV for.
echo GNOS rc: mount -a
/bin/mount -a
echo GNOS rc: mount -a exited with status $?
echo "--- mounted filesystems ---"
/bin/mount

# ---- coldplug ------------------------------------------------------------
# The udev-trigger equivalent: walk the kernel's subsystem registry through
# /proc/subsystems and publish the /dev node every live driver advertises.
echo GNOS rc: coldplug
/bin/coldplug.elf
echo GNOS rc: coldplug exited with status $?
echo "--- /proc/devices ---"
/usr/bin/cat /proc/devices

# ---- OpenRC --------------------------------------------------------------
# Bring the boot runlevels up through OpenRC's own machinery.  The initrd
# carries the full tree (/sbin/openrc, /etc/init.d/*, /etc/runlevels/*); this
# is exactly what the kernel's mount/getrandom/symlink/rename support was
# built to serve.  Scripts that need a filesystem our mount(2) cannot provide
# (proc/sys/devtmpfs) fail their mount and are skipped by design, so a missing
# feature degrades to a warning instead of stopping the boot.
#
# We are not using openrc-init as PID 1 (our own init.elf is), so a bare
# `openrc` only caches the dependency tree.  Naming the runlevels explicitly
# is what actually starts the services, the way openrc-init would sequence
# them: sysinit -> boot -> default.
echo GNOS rc: openrc sysinit
/sbin/openrc sysinit
echo GNOS rc: openrc sysinit exited with status $?
echo GNOS rc: openrc boot
/sbin/openrc boot
echo GNOS rc: openrc boot exited with status $?
echo GNOS rc: openrc default
/sbin/openrc default
echo GNOS rc: openrc default exited with status $?
